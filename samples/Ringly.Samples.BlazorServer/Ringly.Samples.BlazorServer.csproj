<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Windows-targeted (not plain net10.0): required by SIPSorceryMedia.Windows's WinRT
         MediaCapture dependency (headless webcam capture — see WindowsVideoFramePreviewSource.cs
         for why this replaced the CustomWindowsVideoEndPoint/CameraView approach). Matches
         Ringly.Samples.Maui's own Windows TFM/SupportedOSPlatformVersion. This project already
         assumed Windows at runtime via NAudio for audio, so this doesn't newly restrict anything. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Ringly.Client.Abstractions\Ringly.Client.Abstractions.csproj" />
    <ProjectReference Include="..\..\Ringly.Client.SipSorcery\Ringly.Client.SipSorcery.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real microphone/speaker access — same package Ringly.Samples.Maui/Ringly.Samples.BlazorHybrid
         use for their Windows target, via the same linked CustomWindowsAudioEndPoint below. Also
         backs this project's own AudioTonePlayerBroker (dial/ring tone playback — no MAUI here,
         so Plugin.Maui.Audio isn't available). -->
    <PackageReference Include="NAudio" Version="2.3.0" />
    <!-- Headless webcam capture (WinRT MediaCapture internally, no CameraView/MAUI) — see
         WindowsVideoFramePreviewSource.cs's own comment. -->
    <PackageReference Include="SIPSorceryMedia.Windows" Version="10.0.15" />
    <!-- Pure managed C# VP8 codec — same package Ringly.Samples.Maui/Ringly.Samples.BlazorHybrid
         use; Vpx.Net.VP8Codec implements SIPSorceryMedia.Abstractions.IVideoEncoder, which is
         exactly what WindowsVideoEndPoint's constructor needs. -->
    <PackageReference Include="SIPSorcery.VP8" Version="10.0.15" />
    <!-- HTTP client wrapper for SupportApiBroker (calling Ringly.Samples.WebApi) — house
         convention across this repo's brokers, not a hand-rolled HttpClient. -->
    <PackageReference Include="RESTFulSense" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reuses Ringly.Samples.Maui's platform audio endpoint and tone generator directly (same
         hand-rolled WASAPI capture code, same synthesized-WAV tone code) rather than duplicating
         them — confirmed both have zero MAUI dependency, just NAudio/SIPSorceryMedia.Abstractions
         and plain C# respectively, so they link into this plain ASP.NET Core project cleanly. -->
    <Compile Include="..\Ringly.Samples.Maui\Platforms\Windows\CustomWindowsAudioEndPoint.cs" Link="Platforms\Windows\CustomWindowsAudioEndPoint.cs" />
    <Compile Include="..\Ringly.Samples.Maui\ToneGenerator.cs" Link="ToneGenerator.cs" />
  </ItemGroup>

</Project>

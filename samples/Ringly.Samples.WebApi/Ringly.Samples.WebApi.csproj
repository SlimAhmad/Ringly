<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!-- Controllers inherit RESTFulSense.Controllers.RESTFulController for the
         Ok/Created/BadRequest/NotFound/InternalServerError helpers — house convention, matching
         RESTFulSense's use elsewhere in Ringly (as an HTTP client wrapper for brokers) and other
         Standard-based API projects. -->
    <PackageReference Include="RESTFulSense" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Ringly.Abstractions\Ringly.Abstractions.csproj" />
    <ProjectReference Include="..\..\Ringly.Asterisk\Ringly.Asterisk.csproj" />
    <ProjectReference Include="..\..\Ringly.CallCenter.Abstractions\Ringly.CallCenter.Abstractions.csproj" />
    <ProjectReference Include="..\..\Ringly.CallCenter.Asterisk\Ringly.CallCenter.Asterisk.csproj" />
  </ItemGroup>

</Project>
